{
  "schema": "clark-om-preset/2",
  "label": "Трёхфазная звезда — импульсы",
  "selection": {
    "schema": "clark-om-client/1",
    "model": "circuit",
    "version": "2.0.0",
    "dataFile": "circuit-config.json",
    "couplingFile": "server-config.json"
  },
  "data": {
    "schema": "clark-circuit/2",
    "phases": 3,
    "parallel": 1,
    "floatingNeutral": true,
    "acceptanceTolerance": 1e-08,
    "integrationTolerance": 1e-10,
    "branches": [
      {
        "L_H": 0,
        "R_Ohm": 1
      },
      {
        "L_H": 0,
        "R_Ohm": 1
      },
      {
        "L_H": 0,
        "R_Ohm": 1
      }
    ],
    "emf": [
      {
        "pulse": 1,
        "amplitude": 0
      },
      {
        "pulse": 2,
        "amplitude": 0
      },
      {
        "pulse": 3,
        "amplitude": 0
      }
    ]
  },
  "coupling": {
    "schema": "clark-server/1",
    "inputs": [
      {
        "kind": "AMP",
        "indices": [
          1,
          2,
          3
        ]
      }
    ],
    "outputs": [
      {
        "kind": "PSI",
        "indices": [
          1,
          2,
          3
        ]
      },
      {
        "kind": "RSP",
        "indices": [
          1,
          2,
          3
        ]
      }
    ]
  },
  "contract": {
    "dataSchema": "clark-circuit/2",
    "structural": {},
    "dimensions": {
      "phases": {
        "minimum": 1
      },
      "parallel": {
        "minimum": 1
      }
    },
    "arraySizes": {
      "branches": "phases*parallel",
      "emf": "phases"
    },
    "variants": [
      {
        "key": "grounded",
        "when": {
          "floatingNeutral": false
        },
        "minimumSizes": {
          "branches": 1
        }
      },
      {
        "key": "floating",
        "when": {
          "floatingNeutral": true
        },
        "minimumSizes": {
          "branches": 2
        }
      }
    ],
    "parameterBindings": [
      {
        "parameter": "nPhase",
        "path": [
          "phases"
        ],
        "type": "integer",
        "minimum": 1
      },
      {
        "parameter": "nParallel",
        "path": [
          "parallel"
        ],
        "type": "integer",
        "minimum": 1
      },
      {
        "repeat": "branches",
        "parameter": "L[{i}]",
        "path": [
          "branches",
          "$index",
          "L_H"
        ],
        "type": "real",
        "minimum": 0
      },
      {
        "repeat": "branches",
        "parameter": "R[{i}]",
        "path": [
          "branches",
          "$index",
          "R_Ohm"
        ],
        "type": "real",
        "minimum": 0
      }
    ],
    "tables": [
      {
        "repeat": "emf",
        "name": "emf{i}",
        "source": "task-pulse",
        "pulsePath": [
          "emf",
          "$index",
          "pulse"
        ],
        "scalePath": [
          "emf",
          "$index",
          "amplitude"
        ]
      }
    ],
    "inputs": [
      {
        "kind": "AMP",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.current[{i}]"
          }
        ]
      }
    ],
    "outputs": [
      {
        "kind": "PSI",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.flux[{i}]"
          }
        ]
      },
      {
        "kind": "RSP",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.resistance[{i}]"
          }
        ]
      }
    ]
  }
}
