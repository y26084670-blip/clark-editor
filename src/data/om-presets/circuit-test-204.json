{
  "schema": "clark-om-preset/2",
  "label": "Тест электрической цепи 204 — три фазы, соединённая нейтраль",
  "selection": {
    "schema": "clark-om-client/1",
    "model": "circuit",
    "version": "2.0.0",
    "dataFile": "circuit-config.json",
    "couplingFile": "server-config.json"
  },
  "data": {
    "schema": "clark-circuit/2",
    "phases": 3,
    "parallel": 1,
    "floatingNeutral": false,
    "acceptanceTolerance": 1,
    "integrationTolerance": 1e-10,
    "branches": [
      {
        "L_H": 100,
        "R_Ohm": 1
      },
      {
        "L_H": 100,
        "R_Ohm": 1
      },
      {
        "L_H": 100,
        "R_Ohm": 1
      }
    ],
    "emf": [
      {
        "pulse": 8,
        "amplitude": 100
      },
      {
        "pulse": 9,
        "amplitude": 100
      },
      {
        "pulse": 10,
        "amplitude": 100
      }
    ],
    "currentIncrement": 10
  },
  "coupling": {
    "schema": "clark-server/1",
    "inputs": [
      {
        "kind": "AMP",
        "indices": [
          1,
          2,
          3
        ]
      }
    ],
    "outputs": [
      {
        "kind": "PSI",
        "indices": [
          1,
          2,
          3
        ]
      },
      {
        "kind": "RSP",
        "indices": [
          1,
          2,
          3
        ]
      }
    ]
  },
  "contract": {
    "dataSchema": "clark-circuit/2",
    "structural": {},
    "dimensions": {
      "phases": {
        "minimum": 1
      },
      "parallel": {
        "minimum": 1
      }
    },
    "arraySizes": {
      "branches": "phases*parallel",
      "emf": "phases"
    },
    "variants": [
      {
        "key": "grounded",
        "when": {
          "floatingNeutral": false
        },
        "minimumSizes": {
          "branches": 1
        }
      },
      {
        "key": "floating",
        "when": {
          "floatingNeutral": true
        },
        "minimumSizes": {
          "branches": 2
        }
      }
    ],
    "parameterBindings": [
      {
        "parameter": "nPhase",
        "path": [
          "phases"
        ],
        "type": "integer",
        "minimum": 1
      },
      {
        "parameter": "nParallel",
        "path": [
          "parallel"
        ],
        "type": "integer",
        "minimum": 1
      },
      {
        "repeat": "branches",
        "parameter": "L[{i}]",
        "path": [
          "branches",
          "$index",
          "L_H"
        ],
        "type": "real",
        "minimum": 0
      },
      {
        "repeat": "branches",
        "parameter": "R[{i}]",
        "path": [
          "branches",
          "$index",
          "R_Ohm"
        ],
        "type": "real",
        "minimum": 0
      },
      {
        "parameter": "currentIncrement",
        "path": [
          "currentIncrement"
        ],
        "type": "real",
        "minimum": 1e-15,
        "default": 10
      }
    ],
    "tables": [
      {
        "repeat": "emf",
        "name": "emf{i}",
        "source": "task-pulse",
        "pulsePath": [
          "emf",
          "$index",
          "pulse"
        ],
        "scalePath": [
          "emf",
          "$index",
          "amplitude"
        ]
      }
    ],
    "inputs": [
      {
        "kind": "AMP",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.current[{i}]"
          }
        ]
      }
    ],
    "outputs": [
      {
        "kind": "PSI",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.flux[{i}]"
          }
        ]
      },
      {
        "kind": "RSP",
        "variables": [
          {
            "repeat": "branches",
            "variable": "fieldPort.resistance[{i}]"
          }
        ]
      }
    ],
    "ui": {
      "schema": "clark-om-panel/1",
      "groups": [
        {
          "id": "structure",
          "label": "Структура цепи",
          "fields": [
            {
              "path": [
                "phases"
              ],
              "label": "Число фаз"
            },
            {
              "path": [
                "parallel"
              ],
              "label": "Ветвей на фазу"
            },
            {
              "path": [
                "floatingNeutral"
              ],
              "label": "Нейтраль",
              "type": "boolean",
              "options": [
                {
                  "value": false,
                  "label": "С нулевым проводом"
                },
                {
                  "value": true,
                  "label": "Без нулевого провода"
                }
              ]
            }
          ]
        },
        {
          "id": "branches",
          "label": "Параметры ветвей",
          "repeat": "branches",
          "rowLabels": [
            "Фаза",
            "Ветвь"
          ],
          "fields": [
            {
              "path": [
                "branches",
                "$index",
                "L_H"
              ],
              "label": "Индуктивность",
              "unit": "Гн"
            },
            {
              "path": [
                "branches",
                "$index",
                "R_Ohm"
              ],
              "label": "Сопротивление",
              "unit": "Ом"
            }
          ]
        },
        {
          "id": "emf",
          "label": "Источники ЭДС",
          "repeat": "emf",
          "rowLabels": [
            "Фаза"
          ],
          "fields": [
            {
              "path": [
                "emf",
                "$index",
                "pulse"
              ],
              "label": "Заданный импульс"
            },
            {
              "path": [
                "emf",
                "$index",
                "amplitude"
              ],
              "label": "Масштаб ЭДС",
              "unit": "В",
              "description": "ЭДС(t) = масштаб × импульс(t). Время импульса — в секундах."
            }
          ]
        },
        {
          "id": "numerics",
          "label": "Параметры вычислений",
          "fields": [
            {
              "path": [
                "acceptanceTolerance"
              ],
              "label": "Допуск невязки уравнений",
              "type": "real",
              "minimum": 0,
              "unit": "В"
            },
            {
              "path": [
                "integrationTolerance"
              ],
              "label": "Допуск OpenModelica",
              "type": "real",
              "minimum": 0
            },
            {
              "path": [
                "currentIncrement"
              ],
              "label": "Приращение тока",
              "unit": "А"
            }
          ]
        }
      ],
      "ports": [
        {
          "side": "inputs",
          "kind": "AMP",
          "label": "Ток ветви {i}",
          "unit": "А"
        },
        {
          "side": "outputs",
          "kind": "PSI",
          "label": "Потокосцепление ветви {i}",
          "unit": "Вб"
        },
        {
          "side": "outputs",
          "kind": "RSP",
          "label": "Сопротивление ветви {i}",
          "unit": "Ом"
        }
      ]
    }
  }
}
