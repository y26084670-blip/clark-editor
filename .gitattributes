# Все распознанные текстовые файлы хранятся и извлекаются с LF
* text=auto eol=lf

# Исходные таблицы и эталон цепи OM сохраняются побайтно из архива владельца.
"public/examples/clark.projects/Open Modelica/test_circuit_with_neutral_1/**" -text
"public/examples/clark.projects/Open Modelica/test_circuit_without_neutral_1/**" -text

# Командные файлы Windows
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Командные файлы Unix
*.sh text eol=lf

# Двоичные файлы — не преобразовывать
*.png binary
*.jpg binary
*.gif binary
*.bmp binary
*.BMP binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.bin binary
